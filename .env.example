# Supabase → Connect. Локал: session pooler 5432. Vercel: 6543 + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=5"
# Нууц түлхүүр: урт санамсаргүй тэмдэгт мөр
SESSION_SECRET="change-me-to-a-long-random-string"
# Админ бүртгэл (npm run db:seed)
ADMIN_PHONE="99999999"
ADMIN_PASSWORD="change-me"
# Web push түлхүүр (npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@teewer.mn"
# /api/cron дуудахад шаардлагатай
CRON_SECRET="change-me"
# Verify.MN: утасны дугаар баталгаажуулах
VERIFY_MN_API_KEY=""
# Зөвхөн локал туршилтад: "1" бол SMS-гүйгээр баталгаажна (production-д БҮҮ ашигла)
VERIFY_MN_MOCK=""
# Нийтийн HTTPS хаяг (Verify.MN callback): https://teewer.mn
APP_URL=""
